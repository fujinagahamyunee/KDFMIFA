      const remainingFeatures = availableFeatures.filter((feature) => feature !== bestFeature);
      return {
        type: "split",
        feature: bestFeature,
        informationGain: bestGain,
        yes: trainDecisionTree(examples.filter(({ features }) => features[bestFeature]), remainingFeatures),
        no: trainDecisionTree(examples.filter(({ features }) => !features[bestFeature]), remainingFeatures)
