<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0b1730">
  <meta name="description" content="의심 문자와 실제 행동을 바탕으로 위험 진행 단계를 추정하고 대응 방법을 안내하는 SafeReply">
  <title>SafeReply | 스미싱 피해 단계 대응</title>
  <style>
    :root {
      color-scheme: light;
      --navy: #0b1730;
      --navy-2: #112344;
      --blue: #2866df;
      --blue-2: #eaf1ff;
      --ink: #17243b;
      --muted: #65728a;
      --line: #e4e9f1;
      --surface: #fff;
      --canvas: #f4f7fb;
      --green: #148568;
      --amber: #bf7715;
      --red: #d34f55;
      --shadow: 0 16px 42px rgba(24, 45, 80, .07);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--canvas);
      color: var(--ink);
      font-family: Inter, Pretendard, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans KR", sans-serif;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    button, textarea { font: inherit; }
    button { cursor: pointer; }
    .topbar {
      height: 72px;
      background: rgba(255,255,255,.96);
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 5;
      backdrop-filter: blur(12px);
    }
    .topbar-inner, main, .footer-inner { width: min(1120px, calc(100% - 48px)); margin: 0 auto; }
    .topbar-inner { display:flex; align-items:center; justify-content:space-between; }
    .brand { display:flex; align-items:center; gap:11px; color:var(--navy); font-size:21px; font-weight:800; letter-spacing:-.6px; text-decoration:none; }
    .brand-mark { width:34px; height:37px; display:grid; place-items:center; color:white; background:var(--blue); border-radius:11px 11px 14px 14px; }
    .brand-mark svg { width:21px; height:23px; }
    .top-meta { display:flex; align-items:center; gap:8px; color:#526078; font-size:13px; font-weight:650; }
    .live-dot { height:8px; width:8px; border-radius:50%; background:#20a37a; box-shadow:0 0 0 4px #e4f5ef; }
    main { padding: 48px 0 76px; }
    .hero { position:relative; display:flex; justify-content:space-between; align-items:center; gap:30px; min-height:330px; margin-bottom:30px; padding:38px 42px; overflow:hidden; border:1px solid #1c3c6b; border-radius:22px; background:radial-gradient(ellipse at 82% 18%,rgba(54,113,207,.35),transparent 36%),linear-gradient(120deg,#0b1730 4%,#10264a 62%,#14325d); box-shadow:0 20px 46px rgba(13,31,61,.19); color:white; }
    .hero::before { content:""; position:absolute; inset:0; background-image:linear-gradient(rgba(196,216,248,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(196,216,248,.045) 1px,transparent 1px); background-size:34px 34px; mask-image:linear-gradient(90deg,transparent 12%,#000 100%); pointer-events:none; }
    .hero-copy { position:relative; z-index:1; flex:1 1 56%; min-width:0; }
    .eyebrow { display:inline-flex; align-items:center; gap:8px; padding:7px 11px; border:1px solid rgba(181,207,248,.23); border-radius:30px; background:rgba(255,255,255,.07); color:#c5d9fa; font-size:11px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
    .eyebrow svg { width:15px; height:15px; }
    h1 { margin:17px 0 12px; max-width:650px; color:white; font-size:clamp(34px, 4.1vw, 48px); line-height:1.16; letter-spacing:-1.8px; }
    .hero p { margin:0; max-width:560px; color:#c5d2e8; font-size:16px; line-height:1.75; }
    .hero-actions { display:flex; align-items:center; gap:16px; flex-wrap:wrap; margin-top:23px; }
    .hero-cta { min-height:47px; display:inline-flex; align-items:center; justify-content:center; gap:10px; padding:0 17px; border-radius:10px; background:#fff; color:#174a9e; box-shadow:0 7px 18px rgba(0,0,0,.18); font-size:14px; font-weight:800; text-decoration:none; transition:transform .15s,background .15s; }
    .hero-cta:hover { transform:translateY(-2px); background:#edf4ff; }
    .hero-cta svg { width:17px; height:17px; }
    .privacy-pill { flex:none; display:flex; align-items:center; gap:8px; color:#c8d6ec; font-size:12px; font-weight:600; }
    .privacy-pill svg { color:#80d2b2; width:17px; }
    .hero-art { position:relative; z-index:1; flex:0 1 385px; height:250px; display:grid; place-items:center; }
    .hero-orbit { position:absolute; width:245px; height:245px; border:1px solid rgba(169,199,244,.22); border-radius:50%; box-shadow:0 0 0 23px rgba(152,188,242,.035),0 0 0 47px rgba(152,188,242,.025); }
    .hero-orbit::before,.hero-orbit::after { content:""; position:absolute; border:1px solid rgba(169,199,244,.14); border-radius:50%; }
    .hero-orbit::before { inset:19px; }
    .hero-orbit::after { inset:43px; }
    .hero-shield { position:absolute; top:27px; right:40px; width:112px; height:122px; display:grid; place-items:center; border:1px solid rgba(180,209,255,.35); border-radius:32px 32px 42px 42px; background:linear-gradient(145deg,rgba(87,145,236,.31),rgba(40,93,176,.17)); box-shadow:0 14px 42px rgba(2,12,30,.24),inset 0 1px rgba(255,255,255,.15); transform:rotate(7deg); }
    .hero-shield svg { width:61px; height:67px; color:#d5e5ff; filter:drop-shadow(0 3px 9px rgba(101,164,255,.5)); transform:rotate(-7deg); }
    .hero-preview { position:absolute; left:0; bottom:11px; width:min(315px,100%); padding:14px 15px 13px; border:1px solid rgba(213,228,251,.23); border-radius:14px; background:rgba(10,25,50,.87); box-shadow:0 15px 35px rgba(2,12,30,.28); backdrop-filter:blur(12px); }
    .preview-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; color:#c5d7f4; font-size:10px; font-weight:800; letter-spacing:.08em; }
    .preview-status { display:flex; align-items:center; gap:6px; color:#a9e2cb; font-size:10px; letter-spacing:0; }
    .preview-status::before { content:""; width:6px; height:6px; border-radius:50%; background:#63d19f; box-shadow:0 0 0 3px rgba(99,209,159,.14); }
    .preview-row { display:flex; align-items:center; gap:9px; padding:7px 0; border-top:1px solid rgba(213,228,251,.1); color:#eef4ff; font-size:12px; font-weight:650; }
    .preview-check { width:20px; height:20px; flex:none; display:grid; place-items:center; border-radius:6px; background:rgba(83,141,229,.2); color:#9cc1ff; font-size:12px; }
    .preview-row small { display:block; color:#9eafca; font-size:10px; font-weight:450; }
    .layout { display:grid; grid-template-columns:minmax(0, 1fr); align-items:start; gap:18px; }
    .left-column, .right-column { display:grid; gap:18px; min-width:0; }
    .card { background:var(--surface); border:1px solid var(--line); border-radius:16px; box-shadow:var(--shadow); }
    .card-pad { padding:24px; }
    .section-heading { display:flex; align-items:flex-start; gap:13px; margin-bottom:20px; }
    .step-icon { width:36px; height:36px; flex:none; display:grid; place-items:center; border-radius:11px; color:var(--blue); background:var(--blue-2); font-weight:800; font-size:14px; }
    .section-heading h2 { margin:0 0 3px; font-size:18px; color:var(--navy); letter-spacing:-.3px; }
    .section-heading p { margin:0; color:var(--muted); font-size:14px; }
    .field-label { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; font-size:15px; font-weight:750; color:#293750; }
    .optional { color:#8a95a8; font-size:12px; font-weight:500; }
    textarea { display:block; width:100%; min-height:144px; padding:14px 15px; border:1px solid #dbe2ec; border-radius:10px; resize:vertical; outline:none; background:#fbfcfe; color:#26344b; font-size:15px; line-height:1.7; transition:border .16s, box-shadow .16s; }
    textarea::placeholder { color:#9aa5b5; }
    textarea:focus { border-color:#81a5ee; box-shadow:0 0 0 3px rgba(40,102,223,.1); background:white; }
    .char-count { margin-top:6px; text-align:right; color:#78859a; font-size:12px; }
    .hint { margin-top:12px; display:flex; gap:9px; align-items:flex-start; padding:11px 12px; border-radius:9px; background:#f6f8fc; color:#52627c; font-size:13px; }
    .hint svg { width:15px; flex:none; margin-top:1px; color:#6f88b5; }
    .actions-card .section-heading { margin-bottom:16px; }
    .actions-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:9px; }
    .action-option { position:relative; }
    .action-option input { position:absolute; opacity:0; pointer-events:none; }
    .action-option label { min-height:58px; display:flex; gap:10px; align-items:center; padding:10px 11px; border:1px solid #e1e6ee; border-radius:10px; background:white; color:#48566d; font-size:14px; cursor:pointer; transition:.15s ease; }
    .action-option label:hover { border-color:#b9c9e8; background:#fbfcff; }
    .action-option input:checked + label { border-color:#82a5eb; background:#f2f6ff; color:#1e4fa9; box-shadow:inset 0 0 0 1px rgba(40,102,223,.08); }
    .action-option input:focus-visible + label { outline:3px solid rgba(40,102,223,.25); outline-offset:2px; }
    .check { width:17px; height:17px; flex:none; display:grid; place-items:center; border:1px solid #ccd4e0; border-radius:5px; background:#fff; color:transparent; }
    .action-option input:checked + label .check { border-color:var(--blue); background:var(--blue); color:white; }
    .check svg { width:12px; height:12px; }
    .action-label { line-height:1.4; }
    .button-row { display:flex; gap:9px; margin-top:19px; }
    .btn { display:inline-flex; justify-content:center; align-items:center; gap:8px; min-height:46px; padding:0 16px; border:1px solid transparent; border-radius:9px; font-size:14px; font-weight:750; transition:transform .12s, background .15s, border .15s; }
    .btn:active { transform:translateY(1px); }
    .btn-primary { flex:1; background:var(--blue); color:white; box-shadow:0 5px 12px rgba(40,102,223,.19); }
    .btn-primary:hover { background:#1f58c5; }
    .btn-secondary { background:white; border-color:#dbe2ec; color:#536078; }
    .btn-secondary:hover { background:#f7f9fc; border-color:#c4cfdf; }
    .btn svg { width:16px; height:16px; }
    .footnote { margin:12px 0 0; color:#65728a; text-align:center; font-size:12px; }
    .result-card { overflow:hidden; }
    .result-top { padding:22px 22px 18px; background:linear-gradient(145deg,#10264a,#173866); color:white; }
    .result-title { display:flex; align-items:center; justify-content:space-between; gap:12px; }
    .result-title h2 { margin:0; font-size:16px; letter-spacing:-.2px; }
    .result-badge { padding:4px 8px; border:1px solid rgba(255,255,255,.21); border-radius:20px; color:#d5e4ff; font-size:11px; font-weight:700; white-space:nowrap; }
    .risk-number { margin-top:19px; display:flex; align-items:baseline; gap:9px; }
    .risk-number strong { font-size:38px; line-height:1; letter-spacing:-1px; }
    .risk-number span { color:#c7d7f0; font-size:14px; font-weight:650; }
    .risk-caption { margin:7px 0 0; color:#d1dbee; font-size:13px; }
    .progress { display:grid; grid-template-columns:repeat(4,1fr); gap:5px; margin-top:20px; }
    .progress span { height:5px; border-radius:8px; background:rgba(255,255,255,.19); }
    .progress span.active { background:#6ea3ff; }
    .stage-labels { display:grid; grid-template-columns:repeat(4,1fr); margin-top:7px; color:#b6c8e3; font-size:11px; text-align:center; }
    .result-content { padding:19px 21px 21px; }
    .message-analysis { margin-bottom:22px; padding:16px; border:1px solid #e1e8f3; border-radius:12px; background:#f8faff; }
    .message-analysis-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:8px; }
    .message-analysis-head h3 { margin:0; color:#273751; font-size:16px; }
    .signal-badge { flex:none; padding:5px 10px; border-radius:20px; font-size:12px; font-weight:800; }
    .signal-empty { background:#edf0f5; color:#606e83; }
    .signal-low { background:#e9f4ef; color:#18704e; }
    .signal-caution { background:#fff3dc; color:#8a5a08; }
    .signal-high { background:#ffe9e8; color:#a83236; }
    .message-analysis-note { margin:0 0 10px; color:#52627c; font-size:14px; line-height:1.65; }
    .message-signal-list { display:grid; gap:7px; margin:0; padding-left:20px; color:#43536d; font-size:14px; line-height:1.6; }
    .message-signal-list li::marker { color:#4779d0; }
    .result-section-title { display:flex; align-items:center; gap:8px; margin:0 0 10px; color:#273751; font-size:15px; font-weight:800; }
    .result-section-title svg { width:15px; height:15px; color:var(--blue); }
    .reason-list { display:grid; gap:8px; margin:0 0 19px; padding:0; list-style:none; }
    .reason-list li { position:relative; padding-left:13px; color:#4f5e75; font-size:13px; line-height:1.65; }
    .reason-list li::before { content:""; position:absolute; left:0; top:7px; width:5px; height:5px; border-radius:50%; background:#4d7dd8; }
    .response-box { padding:12px; border:1px solid #e2eaf7; border-radius:10px; background:#f6f9ff; }
    .response-box h3 { margin:0 0 9px; color:#284777; font-size:14px; }
    .response-box p { margin:0; color:#43536d; font-size:14px; line-height:1.7; }
    .response-steps { display:grid; gap:9px; margin:0; padding-left:22px; color:#43536d; font-size:14px; line-height:1.7; }
    .response-steps li { padding-left:2px; }
    .result-actions { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:13px; }
    .result-actions .btn { min-height:42px; padding:0 8px; font-size:12px; }
    .empty-note { padding:15px; border-radius:10px; background:#f5f7fb; color:#68758a; font-size:13px; line-height:1.65; }
    .tree-card { padding:20px; }
    .small-card-head { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:14px; }
    .small-card-head h2 { margin:0; color:var(--navy); font-size:16px; }
    .mini-tag { padding:3px 7px; background:#f0f3f8; border-radius:5px; color:#647189; font-size:11px; font-weight:700; }
    .tree { display:grid; gap:6px; }
    .tree-node { display:flex; align-items:center; gap:8px; padding:9px 10px; border:1px solid #e7ebf2; border-radius:8px; color:#56647b; font-size:13px; line-height:1.5; transition:.15s; }
    .tree-node.active { color:#2454a8; border-color:#a9c2f1; background:#f2f6ff; font-weight:700; }
    .tree-node .node-dot { width:7px; height:7px; border-radius:50%; background:#c1cad8; }
    .tree-node.active .node-dot { background:var(--blue); box-shadow:0 0 0 3px #dce8ff; }
    .branch-result { margin-left:auto; color:#2454a8; font-size:12px; }
    .tree-leaf { padding:9px 10px; border-radius:8px; background:#eaf1ff; color:#214d99; font-size:13px; font-weight:800; }
    .tree-outcome { margin:8px 0 0; padding:10px 12px; border-left:2px solid #a9c2f1; color:#4f5e75; font-size:13px; line-height:1.65; }
    .tree-note { margin:12px 0 0; color:#66748a; font-size:12px; line-height:1.6; }
    .notice { margin-top:20px; display:flex; gap:11px; padding:14px 16px; border:1px solid #e6dcbf; border-radius:11px; background:#fffaf0; color:#5e5139; font-size:14px; line-height:1.7; }
    .notice svg { width:17px; height:17px; flex:none; margin-top:1px; color:#ad8238; }
    .notice strong { color:#554629; }
    footer { border-top:1px solid var(--line); background:white; }
    .footer-inner { display:flex; justify-content:space-between; gap:20px; padding:22px 0; color:#68758a; font-size:12px; }
    .footer-inner strong { color:#43516a; }
    .toast { position:fixed; z-index:10; bottom:22px; left:50%; transform:translate(-50%, 14px); padding:11px 16px; border-radius:9px; background:#102344; box-shadow:0 8px 24px #10234433; color:white; font-size:14px; opacity:0; pointer-events:none; transition:.2s; }
    .toast.show { transform:translate(-50%,0); opacity:1; }
    .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
    @media (max-width: 860px) {
      .card-pad { padding:20px; }
      .hero { gap:18px; padding:32px; }
      .hero-art { flex-basis:330px; }
      .hero-shield { right:25px; }
    }
    @media (max-width: 700px) {
      .topbar { height:62px; }
      .topbar-inner, main, .footer-inner { width:min(100% - 32px, 520px); }
      main { padding:30px 0 44px; }
      .hero { min-height:0; flex-direction:column; align-items:stretch; gap:22px; margin-bottom:22px; padding:27px 24px 23px; border-radius:18px; }
      .hero-art { width:100%; height:220px; flex:none; }
      .hero-orbit { width:200px; height:200px; }
      .hero-shield { top:0; right:calc(50% - 110px); width:92px; height:100px; border-radius:26px 26px 34px 34px; }
      .hero-shield svg { width:51px; height:56px; }
      .hero-preview { left:50%; bottom:0; width:min(310px,100%); transform:translateX(-50%); }
      .hero p { font-size:14px; }
      .hero-actions { gap:13px; margin-top:18px; }
      .privacy-pill { font-size:12px; }
      .result-card { display:grid; grid-template-columns:1fr; }
      .actions-list { grid-template-columns:1fr 1fr; }
      .tree-card { padding:18px; }
      .footer-inner { flex-direction:column; gap:5px; }
    }
    @media (max-width: 390px) {
      .top-meta { font-size:11px; }
      .actions-list { grid-template-columns:1fr; }
      .card-pad { padding:17px; }
      .hero { padding:23px 18px 20px; }
      h1 { font-size:34px; letter-spacing:-1.3px; }
      .hero-actions { align-items:flex-start; flex-direction:column; }
      .hero-cta { width:100%; }
      .hero-art { height:210px; }
      .hero-preview { width:100%; }
    }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior:auto !important; transition:none !important; } }
  </style>
</head>
<body>
  <header class="topbar">
