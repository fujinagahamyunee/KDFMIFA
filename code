    function labelScenario(features) {
      if (features.transfer || features.loss) return 4;
      if (features.installed || features.personal || features.financial) return 3;
      if (features.clicked) return 2;
      return 1;
    }

    function generateTrainingExamples() {
      return Array.from({ length: 1 << TREE_FEATURES.length }, (_, combination) => {
        const features = Object.fromEntries(
          TREE_FEATURES.map((feature, index) => [feature, Boolean(combination & (1 << index))])
        );
        return { features, stage: labelScenario(features) };
      });
    }

    function entropy(examples) {
      const counts = new Map();
      examples.forEach(({ stage }) => counts.set(stage, (counts.get(stage) || 0) + 1));
      return [...counts.values()].reduce((total, count) => {
        const probability = count / examples.length;
        return total - probability * Math.log2(probability);
      }, 0);
    }

    function majorityStage(examples) {
      const counts = new Map();
      examples.forEach(({ stage }) => counts.set(stage, (counts.get(stage) || 0) + 1));
      return [...counts].sort((a, b) => b[1] - a[1] || a[0] - b[0])[0][0];
    }

    function trainDecisionTree(examples, availableFeatures = TREE_FEATURES) {
      const stages = new Set(examples.map(({ stage }) => stage));
      if (stages.size === 1 || availableFeatures.length === 0) {
        return { type: "leaf", stage: majorityStage(examples) };
      }

      const parentEntropy = entropy(examples);
      let bestFeature = null;
      let bestGain = 0;
      for (const feature of availableFeatures) {
        const yes = examples.filter(({ features }) => features[feature]);
        const no = examples.filter(({ features }) => !features[feature]);
